/* ===== AI Resume Screening System - Theme Styles ===== */

/* CSS Variables for Dark/Light themes */
:root {
    --bg-primary: #f0f4f8;
    --bg-secondary: #ffffff;
    --bg-card: #ffffff;
    --text-primary: #1a202c;
    --text-secondary: #4a5568;
    --text-muted: #718096;
    --border-color: #e2e8f0;
    --primary: #6c5ce7;
    --primary-hover: #5a4bd1;
    --primary-soft: #e8e6fb;
    --info-soft: #d6f0fb;
    --success-soft: #d4f5e2;
    --danger-soft: #fde2e2;
    --warning-soft: #fff3d6;
    --purple-soft: #e9d8fd;
    --shadow: 0 4px 20px rgba(0, 0, 0, 0.06);
    --shadow-hover: 0 8px 30px rgba(0, 0, 0, 0.12);
    --navbar-bg: #ffffff;
    --login-bg: linear-gradient(135deg, #6c5ce7 0%, #a29bfe 50%, #74b9ff 100%);
}

[data-theme="dark"] {
    --bg-primary: #0f172a;
    --bg-secondary: #1e293b;
    --bg-card: #1e293b;
    --text-primary: #f1f5f9;
    --text-secondary: #cbd5e1;
    --text-muted: #94a3b8;
    --border-color: #334155;
    --primary: #818cf8;
    --primary-hover: #6366f1;
    --primary-soft: #312e81;
    --info-soft: #164e63;
    --success-soft: #14532d;
    --danger-soft: #7f1d1d;
    --warning-soft: #713f12;
    --purple-soft: #4c1d95;
    --shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
    --shadow-hover: 0 8px 30px rgba(0, 0, 0, 0.5);
    --navbar-bg: #1e293b;
    --login-bg: linear-gradient(135deg, #1e1b4b 0%, #312e81 50%, #1e3a8a 100%);
}

/* ===== Base Styles ===== */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    background-color: rgba(240, 244, 248, 0.6);
    color: var(--text-primary);
    min-height: 100vh;
    transition: background-color 0.3s ease, color 0.3s ease;
}

[data-theme="dark"] body {
    background-color: rgba(15, 23, 42, 0.6);
    color: #f1f5f9;
}

/* Ensure text is visible in dark mode */
[data-theme="dark"] .page-title,
[data-theme="dark"] .stat-value,
[data-theme="dark"] .stat-label,
[data-theme="dark"] .card-title,
[data-theme="dark"] .card-text,
[data-theme="dark"] .table,
[data-theme="dark"] .table td,
[data-theme="dark"] .table th,
[data-theme="dark"] .form-label,
[data-theme="dark"] .form-control,
[data-theme="dark"] .form-select,
[data-theme="dark"] .text-muted,
[data-theme="dark"] .login-title,
[data-theme="dark"] .login-subtitle,
[data-theme="dark"] .login-footer,
[data-theme="dark"] .navbar-brand,
[data-theme="dark"] .navbar-custom .nav-link,
[data-theme="dark"] .user-btn,
[data-theme="dark"] .action-card h5,
[data-theme="dark"] .action-card p,
[data-theme="dark"] .dashboard-hero p,
[data-theme="dark"] .explanation-box,
[data-theme="dark"] .extracted-text,
[data-theme="dark"] .email-preview,
[data-theme="dark"] .score-number {
    color: #f1f5f9 !important;
}

[data-theme="dark"] .text-muted {
    color: #94a3b8 !important;
}

[data-theme="dark"] .card-custom,
[data-theme="dark"] .stat-card,
[data-theme="dark"] .action-card,
[data-theme="dark"] .job-card,
[data-theme="dark"] .dashboard-hero,
[data-theme="dark"] .login-card {
    background-color: rgba(30, 41, 59, 0.85);
    border-color: #334155;
}

.main-content {
    min-height: calc(100vh - 70px);
    /* Page content sits above the fixed 3D background canvas */
    position: relative;
    z-index: 1;
}

/* ===== Navbar ===== */
.navbar-custom {
    background: var(--navbar-bg);
    box-shadow: var(--shadow);
    padding: 0.75rem 0;
    transition: background-color 0.3s ease;
}

.brand-icon {
    width: 38px;
    height: 38px;
    background: linear-gradient(135deg, #6c5ce7, #a29bfe);
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    font-size: 18px;
}

.brand-text {
    font-weight: 700;
    font-size: 1.15rem;
    color: var(--text-primary);
}

.brand-accent {
    color: var(--primary);
}

.navbar-custom .nav-link {
    color: var(--text-secondary);
    font-weight: 500;
    padding: 0.5rem 1rem;
    border-radius: 8px;
    transition: all 0.2s ease;
}

.navbar-custom .nav-link:hover {
    color: var(--primary);
    background: var(--primary-soft);
}

.navbar-custom .nav-link.active {
    color: var(--primary);
    background: var(--primary-soft);
}

.theme-toggle {
    background: var(--bg-primary);
    border: 1px solid var(--border-color);
    border-radius: 50%;
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-secondary);
    cursor: pointer;
    transition: all 0.3s;
    font-size: 1rem;
}

.theme-toggle:hover {
    transform: rotate(20deg);
    color: var(--primary);
}

.user-btn {
    background: var(--bg-primary);
    color: var(--text-primary);
    border: 1px solid var(--border-color);
    font-weight: 500;
}

.user-btn:hover {
    background: var(--primary-soft);
    color: var(--primary);
}

/* ===== Cards ===== */
.card-custom {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: 16px;
    box-shadow: var(--shadow);
    overflow: hidden;
    transition: all 0.3s ease;
}

.card-custom:hover {
    box-shadow: var(--shadow-hover);
    transform: translateY(-2px);
}

.card-header-custom {
    background: var(--bg-primary);
    border-bottom: 1px solid var(--border-color);
    padding: 1rem 1.25rem;
}

/* ===== Page Title ===== */
.page-title {
    font-weight: 700;
    font-size: 1.75rem;
    color: var(--text-primary);
    margin-bottom: 0.25rem;
}

/* ===== Stat Cards ===== */
.stat-card {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: 16px;
    padding: 1.5rem 1.25rem;
    box-shadow: var(--shadow);
    text-align: center;
    transition: all 0.3s ease;
    cursor: default;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    color: inherit;
    overflow: hidden;
    min-width: 0;
    height: 100%;
    width: 100%;
}

.stat-card-link {
    cursor: pointer;
}

.stat-card-link:hover {
    text-decoration: none;
    color: inherit;
}

.stat-card:hover {
    transform: translateY(-5px);
    box-shadow: var(--shadow-hover);
}

.stat-icon {
    width: 45px;
    height: 45px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.2rem;
    margin: 0 auto 0.75rem;
}

.stat-value {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--text-primary);
    overflow-wrap: break-word;
    word-wrap: break-word;
}

.stat-label {
    font-size: 0.8rem;
    color: var(--text-muted);
    font-weight: 500;
    overflow-wrap: break-word;
    word-wrap: break-word;
}

/* Soft backgrounds */
.bg-primary-soft { background: var(--primary-soft); color: var(--primary); }
.bg-info-soft { background: var(--info-soft); color: #0ea5e9; }
.bg-success-soft { background: var(--success-soft); color: #10b981; }
.bg-danger-soft { background: var(--danger-soft); color: #ef4444; }
.bg-warning-soft { background: var(--warning-soft); color: #f59e0b; }
.bg-purple-soft { background: var(--purple-soft); color: #8b5cf6; }

/* ===== Action Cards ===== */
.action-card {
    display: flex;
    align-items: center;
    gap: 1rem;
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: 16px;
    padding: 1.5rem;
    box-shadow: var(--shadow);
    text-decoration: none;
    color: var(--text-primary);
    transition: all 0.3s ease;
    height: 100%;
    overflow: hidden;
    min-width: 0;
}

.action-card > div:last-child {
    min-width: 0;
    overflow-wrap: break-word;
    word-wrap: break-word;
}

.action-card:hover {
    transform: translateY(-5px);
    box-shadow: var(--shadow-hover);
    border-color: var(--primary);
    color: var(--text-primary);
}

.action-icon {
    width: 48px;
    height: 48px;
    border-radius: 12px;
    background: var(--primary-soft);
    color: var(--primary);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.3rem;
    flex-shrink: 0;
}

/* ===== Login Page ===== */
.login-wrapper {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--login-bg);
    padding: 1rem;
}

.login-card {
    background: var(--bg-card);
    border-radius: 20px;
    padding: 2.5rem;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.25);
    max-width: 420px;
    width: 100%;
}

.login-header {
    text-align: center;
    margin-bottom: 1.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
}

.login-logo {
    width: 64px;
    height: 64px;
    margin: 0 auto 1rem !important;
    background: linear-gradient(135deg, #6c5ce7, #a29bfe);
    border-radius: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.8rem;
    color: #fff;
    position: relative;
    z-index: 2;
    transform: none !important;
}

.login-title {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-top: 0.5rem;
    margin-bottom: 0.25rem;
    position: relative;
    z-index: 1;
    clear: both;
}

.login-subtitle {
    color: var(--text-muted);
    font-size: 0.9rem;
}

.login-btn {
    background: linear-gradient(135deg, #6c5ce7, #a29bfe);
    border: none;
    font-weight: 600;
    transition: all 0.3s ease;
}

.login-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(108, 92, 231, 0.4);
}

.login-footer {
    text-align: center;
}

/* ===== Buttons ===== */
.btn-primary {
    background: var(--primary);
    border-color: var(--primary);
}

.btn-primary:hover {
    background: var(--primary-hover);
    border-color: var(--primary-hover);
    transform: translateY(-1px);
}

/* ===== Jobs ===== */
.job-card {
    border: 1px solid var(--border-color);
    border-radius: 16px;
    transition: all 0.3s ease;
}

.job-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-hover);
    border-color: var(--primary);
}

.job-icon {
    width: 44px;
    height: 44px;
    border-radius: 10px;
    background: var(--primary-soft);
    color: var(--primary);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.1rem;
}

.job-desc {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
}

.job-desc-full {
    white-space: pre-wrap;
}

.skill-badge {
    background: var(--primary-soft);
    color: var(--primary);
    font-weight: 500;
    padding: 0.35rem 0.75rem;
    border-radius: 20px;
}

/* ===== Score Elements ===== */
.score-progress {
    height: 8px;
    border-radius: 4px;
    background: var(--bg-primary);
}

.score-circle {
    width: 120px;
    height: 120px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto;
    position: relative;
    background: var(--bg-primary);
}

.score-circle::before {
    content: '';
    position: absolute;
    inset: -6px;
    border-radius: 50%;
}

.score-high::before {
    background: conic-gradient(#10b981 var(--score-angle), var(--bg-primary) 0);
}

.score-mid::before {
    background: conic-gradient(#f59e0b var(--score-angle), var(--bg-primary) 0);
}

.score-low::before {
    background: conic-gradient(#ef4444 var(--score-angle), var(--bg-primary) 0);
}

.score-number {
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--text-primary);
    position: relative;
    z-index: 1;
}

/* Holographic score circle - premium 3D treatment */
.score-hologram {
    box-shadow: 0 0 0 1px rgba(108, 92, 231, 0.2),
                0 0 30px rgba(108, 92, 231, 0.15),
                inset 0 0 20px rgba(108, 92, 231, 0.08);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.score-hologram:hover {
    transform: scale(1.05);
    box-shadow: 0 0 0 1px rgba(108, 92, 231, 0.35),
                0 0 50px rgba(108, 92, 231, 0.25),
                inset 0 0 30px rgba(108, 92, 231, 0.12);
}


.explanation-box {
    background: var(--bg-primary);
    border-left: 4px solid var(--primary);
    padding: 1rem 1.25rem;
    border-radius: 0 12px 12px 0;
    color: var(--text-secondary);
    line-height: 1.7;
}

.email-preview {
    background: var(--bg-primary);
    border: 1px solid var(--border-color);
    border-radius: 12px;
    padding: 1.25rem;
    font-family: 'Segoe UI', sans-serif;
    line-height: 1.6;
    white-space: pre-wrap;
    color: var(--text-secondary);
}

.extracted-text {
    background: var(--bg-primary);
    border-radius: 8px;
    padding: 0.75rem;
    font-size: 0.8rem;
    color: var(--text-muted);
    max-height: 200px;
    overflow-y: auto;
    white-space: pre-wrap;
}

/* ===== Tables ===== */
.table {
    color: var(--text-primary);
}

.table thead th {
    background: var(--bg-primary);
    color: var(--text-muted);
    font-weight: 600;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    border-bottom: 1px solid var(--border-color);
}

.table tbody td {
    border-color: var(--border-color);
    vertical-align: middle;
}

.table-hover tbody tr:hover {
    background: var(--bg-primary);
}

/* ===== Forms ===== */
.form-control,
.form-select {
    background: var(--bg-primary);
    border: 1px solid var(--border-color);
    color: var(--text-primary);
    border-radius: 10px;
    transition: all 0.3s ease;
}

.form-control:focus,
.form-select:focus {
    background: var(--bg-primary);
    border-color: var(--primary);
    box-shadow: 0 0 0 0.2rem var(--primary-soft);
    color: var(--text-primary);
}

.form-control::placeholder {
    color: var(--text-muted);
}

.form-label {
    color: var(--text-secondary);
    font-size: 0.9rem;
}

.form-text {
    color: var(--text-muted);
}

/* ===== Alerts ===== */
.alert {
    border-radius: 12px;
    border: none;
}

/* ===== Animations ===== */
@keyframes fadeUp {
    from {
        opacity: 0;
        transform: translateY(20px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

@keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
}

@keyframes slideIn {
    from {
        opacity: 0;
        transform: translateX(-20px);
    }
    to {
        opacity: 1;
        transform: translateX(0);
    }
}

.animate-fade-up {
    animation: fadeUp 0.5s ease forwards;
}

.animate-fade-in {
    animation: fadeIn 0.4s ease forwards;
}

.animate-slide-in {
    animation: slideIn 0.3s ease forwards;
}

/* ===== OTP Inputs ===== */
.otp-container{
    gap: 0.5rem !important;
}

.otp-input{
    width: 48px !important;
    height: 56px !important;
    font-size: 1.5rem !important;
    font-weight: 700 !important;
    text-align: center !important;
    border-radius: 12px !important;
    border: 2px solid var(--border-color) !important;
    background: var(--bg-primary) !important;
    color: var(--text-primary) !important;
    transition: all 0.3s ease;
    padding: 0 !important;
}

.otp-input:focus{
    border-color: var(--primary) !important;
    box-shadow: 0 0 0 0.2rem var(--primary-soft) !important;
    transform: scale(1.05);
}

/* ===== Responsive ===== */
@media (max-width: 768px) {
    .page-title {
        font-size: 1.35rem;
    }
    
    .login-card {
        padding: 1.75rem;
    }
    
    .stat-value {
        font-size: 1.2rem;
    }
    
    .d-flex.justify-content-between.align-items-center.mb-4 {
        flex-direction: column;
        gap: 1rem;
        align-items: flex-start !important;
    }
    
    .navbar-brand .brand-text {
        font-size: 1rem;
    }
}

@media (max-width: 576px) {
    .container-fluid {
        padding-left: 1rem !important;
        padding-right: 1rem !important;
    }
    
    .btn-lg {
        font-size: 0.9rem;
    }
}

/* ============================================================
   ===== PREMIUM 3D EXPERIENCE LAYER =====
   Futuristic glassmorphism, holographic cards, cinematic depth
   ============================================================ */

/* 3D Canvas - fixed layered above body bg but behind content */
#bg-3d-canvas {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    z-index: 0;
    pointer-events: none;
    opacity: 0.8;
    transition: opacity 0.6s ease;
    background: transparent;
}

/* 3D scene shows through via semi-transparent overlays */
.login-wrapper {
    background: linear-gradient(135deg, rgba(108, 92, 231, 0.35) 0%, rgba(162, 155, 254, 0.25) 50%, rgba(116, 185, 255, 0.3) 100%) !important;
}

[data-theme="dark"] .login-wrapper {
    background: linear-gradient(135deg, rgba(30, 27, 75, 0.55) 0%, rgba(49, 46, 129, 0.5) 50%, rgba(30, 58, 138, 0.5) 100%) !important;
}

.navbar-custom {
    background: rgba(255, 255, 255, 0.75);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
}

[data-theme="dark"] .navbar-custom {
    background: rgba(30, 41, 59, 0.72);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
}

/* Place content above the 3D layer */
main, .login-wrapper, .navbar-custom {
    position: relative;
    z-index: 1;
}

.login-card, .card-custom, .dashboard-hero, .stat-card, .action-card, .job-card {
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
}

/* Dashboard hero header - cinematic entrance */
.dashboard-hero {
    padding: 2rem 2.5rem;
    border-radius: 20px;
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.dashboard-hero .page-title {
    font-size: 2rem;
    background: linear-gradient(135deg, #6c5ce7, #a29bfe, #74b9ff);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    display: inline-block;
}

/* Glass / holographic card effect for depth-focused components */
.tilt-3d {
    transform-style: preserve-3d;
    will-change: transform;
}

/* Holographic glow on cards (stat, action, job) */
.holo-card, .stat-card, .action-card, .job-card {
    position: relative;
    overflow: hidden;
}

.holo-card::after, .stat-card::after, .action-card::after, .job-card::after {
    content: '';
    position: absolute;
    top: -60%;
    left: -30%;
    width: 60%;
    height: 220%;
    background: linear-gradient(
        120deg,
        rgba(108, 92, 231, 0) 0%,
        rgba(108, 92, 231, 0.09) 40%,
        rgba(255, 255, 255, 0.15) 50%,
        rgba(108, 92, 231, 0.09) 60%,
        rgba(108, 92, 231, 0) 100%
    );
    transform: rotate(12deg);
    pointer-events: none;
    transition: transform 0.8s cubic-bezier(0.4, 0, 0.2, 1);
    z-index: 1;
}

.holo-card:hover::after, .stat-card:hover::after,
.action-card:hover::after, .job-card:hover::after {
    transform: translateX(220%) rotate(12deg);
}

/* Cinematic glow ring on major components */
.cinematic-shadow {
    box-shadow: 0 0 0 1px rgba(108, 92, 231, 0.12),
                0 8px 40px rgba(108, 92, 231, 0.12),
                0 4px 12px rgba(0, 0, 0, 0.06);
}

.cinematic-shadow:hover {
    box-shadow: 0 0 0 1px rgba(108, 92, 231, 0.25),
                0 16px 60px rgba(108, 92, 231, 0.22),
                0 8px 20px rgba(0, 0, 0, 0.1);
}

/* Depth-aware content elevation */
.depth-1 { transform: translateZ(20px); }
.depth-2 { transform: translateZ(40px); }
.depth-3 { transform: translateZ(60px); }

/* Scroll-triggered reveal - always visible for reliability */
.reveal-on-scroll {
    opacity: 1;
    transform: translateY(0) scale(1);
}

/* Scanline / HUD effect for hero-like elements */
.hud-overlay {
    position: relative;
}

.hud-overlay::before {
    content: '';
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(
        to bottom,
        transparent 0px,
        transparent 2px,
        rgba(108, 92, 231, 0.03) 3px,
        transparent 4px
    );
    pointer-events: none;
    z-index: 0;
    border-radius: inherit;
}

/* Futuristic border glow for key interactive elements */
.glow-border {
    position: relative;
}

.glow-border::before {
    content: '';
    position: absolute;
    inset: -1px;
    border-radius: inherit;
    padding: 1px;
    background: linear-gradient(135deg, #6c5ce7, #a29bfe, #74b9ff, #6c5ce7);
    background-size: 300% 300%;
    animation: borderShift 6s linear infinite;
    -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    pointer-events: none;
    opacity: 0.6;
}

@keyframes borderShift {
    0% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
    100% { background-position: 0% 50%; }
}

.glow-border:hover::before {
    opacity: 1;
}

/* Soft pulsing spotlight behind hero/CTA */
.spotlight-behind {
    position: relative;
}

.spotlight-behind::after {
    content: '';
    position: absolute;
    width: 320px;
    height: 320px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(108, 92, 231, 0.16), rgba(108, 92, 231, 0) 70%);
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    pointer-events: none;
    z-index: -1;
    filter: blur(10px);
    animation: spotlightPulse 4s ease-in-out infinite;
}

@keyframes spotlightPulse {
    0%, 100% { opacity: 0.6; transform: translate(-50%, -50%) scale(1); }
    50% { opacity: 1; transform: translate(-50%, -50%) scale(1.08); }
}

/* Elegant entrance animation for page content */
@keyframes cinematicIn {
    from {
        opacity: 0;
        transform: translateY(24px) scale(0.985);
        filter: blur(6px);
    }
    to {
        opacity: 1;
        transform: translateY(0) scale(1);
        filter: blur(0);
    }
}

.cinematic-in {
    animation: cinematicIn 0.8s cubic-bezier(0.4, 0, 0.2, 1) both;
}

/* Accessibility: reduced-motion = disable 3D UI effects */
@media (prefers-reduced-motion: reduce) {
    #bg-3d-canvas {
        opacity: 0 !important;
    }

    .holo-card::after, .stat-card::after, .action-card::after, .job-card::after {
        display: none;
    }

    .glow-border::before,
    .spotlight-behind::after {
        animation: none;
    }

    .cinematic-in,
    .reveal-on-scroll {
        animation: none;
        opacity: 1;
        transform: none;
        filter: none;
    }
}

/* Mobile: reduce heavy 3D visual effects */
@media (max-width: 768px) {
    #bg-3d-canvas {
        opacity: 0.55; /* Subtler on mobile for perf & readability */
    }

    .spotlight-behind::after {
        width: 200px;
        height: 200px;
    }

    .glow-border::before {
        animation: none; /* Static border on mobile */
    }
}

/* Custom Purple & Soft Badge Utilities */
.bg-purple {
    background-color: #8b5cf6 !important;
    color: #ffffff !important;
}

.text-purple {
    color: #8b5cf6 !important;
}

.bg-purple-soft {
    background-color: rgba(139, 92, 246, 0.15) !important;
    color: #8b5cf6 !important;
}

.bg-primary-soft {
    background-color: rgba(108, 92, 231, 0.12) !important;
}

.bg-success-soft {
    background-color: rgba(16, 185, 129, 0.12) !important;
}

.bg-danger-soft {
    background-color: rgba(239, 68, 68, 0.12) !important;
}

.bg-warning-soft {
    background-color: rgba(245, 158, 11, 0.12) !important;
}

.bg-info-soft {
    background-color: rgba(6, 182, 212, 0.12) !important;
}

