{% extends 'base.html' %}
{% block title %}Candidates - AI Resume Screening{% endblock %}

{% block content %}
<div class="container-fluid px-4 py-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3 animate-fade-up">
        <div class="depth-1">
            <h1 class="page-title mb-1">Candidates</h1>
            <p class="text-muted mb-0">Screened applicants, rankings, and recruitment pipeline.</p>
        </div>
        <div class="d-flex gap-2">
            <button type="button" id="compareBtn" class="btn btn-outline-primary" disabled onclick="handleCompare()">
                <i class="fas fa-columns me-1"></i>Compare Selected (<span id="selectedCount">0</span>)
            </button>
            <a href="{% url 'candidate_upload' %}" class="btn btn-primary glow-border">
                <i class="fas fa-upload me-2"></i>Screen Resumes
            </a>
        </div>
    </div>

    <!-- Search & Filter Controls -->
    <div class="card card-custom mb-4 animate-fade-up cinematic-shadow">
        <div class="card-body p-3">
            <form method="GET" action="{% url 'candidate_list' %}" class="row g-2 align-items-center">
                <!-- Search Input -->
                <div class="col-md-5">
                    <div class="input-group">
                        <span class="input-group-text bg-transparent border-end-0"><i class="fas fa-search text-muted"></i></span>
                        <input type="text" name="q" value="{{ search_query }}" class="form-control border-start-0 ps-0" placeholder="Search name, email, or skill...">
                    </div>
                </div>

                <!-- Job Filter -->
                <div class="col-md-3">
                    <select name="job" class="form-select">
                        <option value="">All Jobs</option>
                        {% for j in jobs %}
                        <option value="{{ j.id }}" {% if selected_job == j.id|stringformat:"i" %}selected{% endif %}>{{ j.title }}</option>
                        {% endfor %}
                    </select>
                </div>

                <!-- Min Score -->
                <div class="col-md-3">
                    <select name="min_score" class="form-select">
                        <option value="">Any Score</option>
                        <option value="80" {% if min_score == '80' %}selected{% endif %}>80%+ (Top Fit)</option>
                        <option value="70" {% if min_score == '70' %}selected{% endif %}>70%+ (Strong)</option>
                        <option value="50" {% if min_score == '50' %}selected{% endif %}>50%+ (Moderate)</option>
                    </select>
                </div>

                <!-- Submit & Clear -->
                <div class="col-md-1 d-flex gap-1">
                    <button type="submit" class="btn btn-primary w-100" title="Apply Filter / Search"><i class="fas fa-filter"></i></button>
                    <a href="{% url 'candidate_list' %}" class="btn btn-outline-secondary" title="Reset Filters"><i class="fas fa-undo"></i></a>
                </div>
            </form>
        </div>
    </div>

    <!-- Candidate List Table -->
    {% if candidates %}
    <form id="bulkForm" method="POST" action="{% url 'candidate_bulk_action' %}">
        {% csrf_token %}
        <div class="card card-custom animate-fade-up cinematic-shadow hud-overlay">
            <div class="card-header bg-transparent border-bottom p-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div class="d-flex align-items-center gap-2">
                    <span class="badge bg-purple-soft text-purple">{{ candidates|length }} Candidates Found</span>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <select name="action" class="form-select form-select-sm" style="width: auto;">
                        <option value="">Bulk Actions...</option>
                        <option value="shortlist">Mark as Shortlisted</option>
                        <option value="reject">Mark as Rejected</option>
                        <option value="send_emails">Send Notification Emails</option>
                        <option value="delete">Delete Selected</option>
                    </select>
                    <button type="submit" class="btn btn-sm btn-outline-secondary" onclick="return confirm('Apply bulk action to selected candidates?')">
                        Apply
                    </button>
                </div>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 40px;" class="text-center">
                                    <input type="checkbox" id="selectAll" class="form-check-input" onclick="toggleSelectAll(this)">
                                </th>
                                <th>#</th>
                                <th>Candidate</th>
                                <th>Job Role</th>
                                <th>Experience</th>
                                <th>Match Score</th>
                                <th>ATS Status</th>
                                <th>Links</th>
                                <th>Screened</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for candidate in candidates %}
                            {% with candidate_score=candidate.scores.first %}
                            <tr>
                                <td class="text-center">
                                    <input type="checkbox" name="candidate_ids" value="{{ candidate.id }}" class="form-check-input candidate-checkbox" onchange="updateSelection()">
                                </td>
                                <td class="fw-bold text-muted">{{ forloop.counter }}</td>
                                <td>
                                    <a href="{% url 'candidate_detail' candidate.id %}" class="fw-bold text-decoration-none text-body d-block">
                                        {{ candidate.name|default:"Candidate" }}
                                    </a>
                                    <small class="text-muted">{{ candidate.email|default:"No email" }}</small>
                                </td>
                                <td><span class="badge bg-light text-dark border">{{ candidate.job.title }}</span></td>
                                <td>
                                    {% if candidate.experience_years > 0 %}
                                    <span class="badge bg-info-soft text-info">{{ candidate.experience_years }} yrs</span>
                                    {% else %}
                                    <span class="text-muted small">—</span>
                                    {% endif %}
                                </td>
                                <td>
                                    {% if candidate_score %}
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="progress score-progress" style="width: 75px; height: 8px;">
                                            <div class="progress-bar {% if candidate_score.overall_score >= candidate.job.cutoff_score %}bg-success{% elif candidate_score.overall_score >= 50 %}bg-warning{% else %}bg-danger{% endif %}"
                                                 style="width: {{ candidate_score.overall_score }}%"></div>
                                        </div>
                                        <span class="fw-bold fs-6">{{ candidate_score.overall_score }}%</span>
                                    </div>
                                    {% else %}
                                    <span class="text-muted">—</span>
                                    {% endif %}
                                </td>
                                <td>
                                    {% if candidate_score %}
                                    {% if candidate_score.status == 'shortlisted' or candidate_score.status == 'selected' %}
                                    <span class="badge bg-success"><i class="fas fa-check me-1"></i>Shortlisted</span>
                                    {% elif candidate_score.status == 'interview' or candidate_score.status == 'technical' %}
                                    <span class="badge bg-purple"><i class="fas fa-user-clock me-1"></i>Interview</span>
                                    {% elif candidate_score.status == 'offered' or candidate_score.status == 'hired' %}
                                    <span class="badge bg-primary"><i class="fas fa-award me-1"></i>Hired</span>
                                    {% elif candidate_score.status == 'rejected' %}
                                    <span class="badge bg-danger"><i class="fas fa-times me-1"></i>Rejected</span>
                                    {% else %}
                                    <span class="badge bg-secondary"><i class="fas fa-file-search me-1"></i>Screened</span>
                                    {% endif %}
                                    {% else %}
                                    <span class="text-muted">—</span>
                                    {% endif %}
                                </td>
                                <td>
                                    <div class="d-flex gap-2">
                                        {% if candidate.linkedin_url %}
                                        <a href="{{ candidate.linkedin_url }}" target="_blank" class="text-primary" title="LinkedIn Profile"><i class="fab fa-linkedin fs-5"></i></a>
                                        {% endif %}
                                        {% if candidate.github_url %}
                                        <a href="{{ candidate.github_url }}" target="_blank" class="text-dark" title="GitHub Profile"><i class="fab fa-github fs-5"></i></a>
                                        {% endif %}
                                        {% if candidate.portfolio_url %}
                                        <a href="{{ candidate.portfolio_url }}" target="_blank" class="text-success" title="Portfolio / Website"><i class="fas fa-globe fs-5"></i></a>
                                        {% endif %}
                                    </div>
                                </td>
                                <td><small class="text-muted">{{ candidate.uploaded_at|date:"M d, Y" }}</small></td>
                                <td class="text-end">
                                    <a href="{% url 'candidate_detail' candidate.id %}" class="btn btn-sm btn-outline-primary">
                                        <i class="fas fa-eye me-1"></i>Details
                                    </a>
                                </td>
                            </tr>
                            {% endwith %}
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </form>
    {% else %}
    <div class="card card-custom text-center py-5 animate-fade-up cinematic-shadow spotlight-behind">
        <i class="fas fa-users fa-3x text-muted mb-3"></i>
        <h4>No Candidates Found</h4>
        <p class="text-muted">No candidate matches your search filter, or no resumes uploaded yet.</p>
        <div class="d-flex justify-content-center gap-2">
            <a href="{% url 'candidate_list' %}" class="btn btn-outline-secondary">Clear Filters</a>
            <a href="{% url 'candidate_upload' %}" class="btn btn-primary glow-border">
                <i class="fas fa-upload me-2"></i>Screen New Resumes
            </a>
        </div>
    </div>
    {% endif %}
</div>

<script>
function toggleSelectAll(master) {
    const checkboxes = document.querySelectorAll('.candidate-checkbox');
    checkboxes.forEach(cb => cb.checked = master.checked);
    updateSelection();
}

function updateSelection() {
    const selected = document.querySelectorAll('.candidate-checkbox:checked');
    const count = selected.length;
    document.getElementById('selectedCount').innerText = count;
    document.getElementById('compareBtn').disabled = (count < 2 || count > 4);
}

function handleCompare() {
    const selected = document.querySelectorAll('.candidate-checkbox:checked');
    const ids = Array.from(selected).map(cb => cb.value).join(',');
    if (ids) {
        window.location.href = "{% url 'candidate_compare' %}?ids=" + ids;
    }
}
</script>
{% endblock %}